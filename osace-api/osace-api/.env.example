NODE_ENV=development
DB_USER=postgres
DB_HOST=localhost
DB_DATABASE=osace_dev_db
DB_PASSWORD=root
DB_PORT=5432
API_BASE_URL=http://localhost:3000
EXPO_ACCESS_TOKEN=your_expo_access_token_here
JWT_SECRET=your_jwt_secret_here

# Email (SMTP — cPanel mail.osace.ro uses port 465 with SSL/TLS)
SMTP_HOST=mail.osace.ro
SMTP_PORT=465
SMTP_USER=contact@osace.ro
SMTP_PASS=your_email_password

# Configurații Versiune Aplicație
MIN_IOS_VERSION=1.0.0
LATEST_IOS_VERSION=1.0.0
MIN_ANDROID_VERSION=1.0.0
LATEST_ANDROID_VERSION=1.0.0
UPDATE_URL=https://osace.ro/app

# Google Drive Archive Configuration
GOOGLE_DRIVE_ENABLED=true
GOOGLE_DRIVE_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=your_oauth_client_secret
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_DRIVE_ROOT_FOLDER_ID=your_root_folder_id
GOOGLE_DRIVE_REFRESH_TOKEN=your_refresh_token_from_setup_script
GOOGLE_DRIVE_MAX_UPLOAD_MB=50

